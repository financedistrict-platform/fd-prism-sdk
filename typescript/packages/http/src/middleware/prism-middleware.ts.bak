import { IncomingMessage, ServerResponse } from 'http';
import * as url from 'url';
import {
  PrismMiddlewareConfig,
  RoutesConfig,
  PaymentPayload,
  PrismMiddlewareCore,
} from '@1stdigital/prism-core';

/**
 * Extended IncomingMessage with parsed data
 */
export interface PrismHttpRequest extends IncomingMessage {
  path?: string;
  payment?: PaymentPayload;
  payer?: string;
}

/**
 * Helper to send response from middleware result
 */
function sendResponse(res: ServerResponse, statusCode: number, headers: Record<string, string>, body: any) {
  res.statusCode = statusCode;

  // Set all headers
  Object.entries(headers).forEach(([key, value]) => {
    res.setHeader(key, value);
  });

  res.end(JSON.stringify(body));
}

/**
 * Create Prism payment middleware for Node.js HTTP server
 * 
 * @param config - Prism middleware configuration
 * @param routes - Routes configuration with payment requirements
 * @returns HTTP middleware function
 * 
 * @example
 * ```typescript
 * const http = require('http');
 * const { prismPaymentMiddleware } = require('@1stdigital/prism-http');
 * 
 * const middleware = prismPaymentMiddleware(
 *   {
 *     apiKey: 'dev-key-123'
 *   },
 *   {
 *     '/api/premium': {
 *       price: 0.01,
 *       description: 'Premium API access'
 *     },
 *     '/weather': {
 *       price: '$0.001',
 *       description: 'Weather data'
 *     }
 *   }
 * );
 * 
 * const server = http.createServer(async (req, res) => {
 *   const handled = await middleware(req, res);
 *   if (!handled) {
 *     // Handle your routes here
 *     res.writeHead(200);
 *     res.end('Hello World');
 *   }
 * });
 * ```
 */
export function prismPaymentMiddleware(
  config: PrismMiddlewareConfig,
  routes: RoutesConfig
) {
  // INTERNAL: Currently hardcoded to 'on-demand' mode
  const mode: ConfigurationMode = 'on-demand';

  // Initialize client for on-demand mode
  // Use injected client if provided (for testing), otherwise create new one
  const client = config.client || new PrismClient(config);

  return async function (
    req: PrismHttpRequest,
    res: ServerResponse
  ): Promise<boolean> {
    // Parse URL
    const parsedUrl = url.parse(req.url || '', true);
    const pathname = parsedUrl.pathname || '/';
    req.path = pathname;

    // Check if current route matches any configured payment route
    const matchedRoute = findMatchingRoute(pathname, routes);

    if (!matchedRoute) {
      // Route doesn't require payment, continue to next handler
      return false;
    }

    const routeConfig = routes[matchedRoute];

    // Check for X-PAYMENT header
    const paymentHeader = req.headers['x-payment'] as string | undefined;

    if (!paymentHeader) {
      // No payment provided, return 402 with payment requirements
      try {
        let paymentRequirements;

        if (mode === 'on-demand') {
          // Call Prism Gateway API
          const protocol = (req.socket as any).encrypted ? 'https' : 'http';
          const host = req.headers.host || 'localhost';
          const resourceUrl = routeConfig.resource || `${protocol}://${host}${req.url}`;
          const price = parsePrice(routeConfig.price);

          const request: PaymentRequirementsRequest = {
            resourceUrl,
            requestedAmount: price,
            description: routeConfig.description || 'Payment required',
            mimeType: routeConfig.mimeType || 'application/json',
          };

          paymentRequirements = await client.getPaymentRequirements(request);
        }

        // Return 402 Payment Required
        res.setHeader('X-PAYMENT-REQUIREMENTS', JSON.stringify(paymentRequirements));
        sendJsonResponse(res, 402, paymentRequirements);
        return true; // Request handled
      } catch (error: any) {
        console.error('Error generating payment requirements:', error);

        // Handle PrismGatewayError (preserve status code and details)
        if (error instanceof PrismGatewayError) {
          sendJsonResponse(res, error.statusCode, {
            x402Version: 1,
            error: error.message,
            details: error.details,
            gateway: {
              traceId: error.traceId,
              timestamp: error.timestamp
            }
          });
          return true;
        }

        // Handle PrismNetworkError (service unavailable)
        if (error instanceof PrismNetworkError) {
          sendJsonResponse(res, 503, {
            x402Version: 1,
            error: 'Payment service unavailable',
            details: 'Could not connect to Prism Gateway. Please try again later.',
            retryAfter: 60
          });
          return true;
        }

        // Unknown error
        sendJsonResponse(res, 500, {
          x402Version: 1,
          error: 'Failed to generate payment requirements',
          details: error.message || 'An unexpected error occurred'
        });
        return true;
      }
    }

    // Payment header provided, verify and process
    try {
      // Parse payment header
      let paymentPayload: PaymentPayload;
      try {
        paymentPayload = JSON.parse(paymentHeader);
      } catch (parseError) {
        sendJsonResponse(res, 400, {
          x402Version: 1,
          error: 'Invalid payment header format',
          details: 'X-PAYMENT header must be valid JSON'
        });
        return true;
      }

      // Reconstruct payment requirements for verification
      const protocol = (req.socket as any).encrypted ? 'https' : 'http';
      const host = req.headers.host || 'localhost';
      const resourceUrl = routeConfig.resource || `${protocol}://${host}${req.url}`;
      const price = parsePrice(routeConfig.price);

      const request: PaymentRequirementsRequest = {
        resourceUrl,
        requestedAmount: price,
        description: routeConfig.description || 'Payment required',
        mimeType: routeConfig.mimeType || 'application/json',
      };

      // Get payment requirements for verification and settlement
      const paymentRequirementsResponse = await client.getPaymentRequirements(request);
      const paymentRequirements = paymentRequirementsResponse.accepts[0];

      // Verify payment with Gateway
      const verificationResult = await client.verifyPayment(paymentHeader, paymentRequirements);

      if (!verificationResult.isValid) {
        sendJsonResponse(res, 402, {
          x402Version: 1,
          error: verificationResult.error || 'Invalid payment',
        });
        return true;
      }

      // Payment is valid, store payment info for route handler access
      req.payment = paymentPayload;
      req.payer = verificationResult.payer;

      // Set up response interception for settlement
      const originalEnd = res.end.bind(res);
      let endCalled = false;

      res.end = function (chunk?: any, encodingOrCallback?: any, callback?: any): any {
        if (endCalled) {
          return originalEnd(chunk, encodingOrCallback, callback);
        }
        endCalled = true;

        // After successful response, settle the payment on blockchain
        if (res.statusCode < 400) {
          client.settlePayment(paymentPayload, paymentRequirements)
            .then((settlementResult: any) => {
              if (settlementResult.success && settlementResult.transaction) {
                console.log(`Payment settled: ${settlementResult.transaction} on ${settlementResult.network || 'unknown'} by ${settlementResult.payer}`);
              } else if (settlementResult.errorReason) {
                console.error('Settlement failed:', settlementResult.errorReason);
              }
            })
            .catch((err: any) => {
              console.error('Error during settlement:', err);
            });
        }

        return originalEnd(chunk, encodingOrCallback, callback);
      };

      // Payment verified, allow request to continue
      return false;
    } catch (error: any) {
      console.error('Error processing payment:', error);

      // If response already sent, just log and return
      if (res.headersSent) {
        console.error('Response already sent, cannot send error response');
        return true;
      }

      // Handle PrismPaymentError (invalid payment)
      if (error instanceof PrismPaymentError) {
        sendJsonResponse(res, 402, {
          x402Version: 1,
          error: error.message,
          details: error.details
        });
        return true;
      }

      // Handle PrismGatewayError (preserve status code and details)
      if (error instanceof PrismGatewayError) {
        sendJsonResponse(res, error.statusCode, {
          x402Version: 1,
          error: 'Payment processing failed',
          details: error.details,
          gateway: {
            traceId: error.traceId,
            timestamp: error.timestamp
          }
        });
        return true;
      }

      // Handle PrismNetworkError (service unavailable)
      if (error instanceof PrismNetworkError) {
        sendJsonResponse(res, 503, {
          x402Version: 1,
          error: 'Payment service unavailable',
          details: 'Could not connect to Prism Gateway. Please try again later.',
          retryAfter: 60
        });
        return true;
      }

      // Unknown error
      sendJsonResponse(res, 500, {
        x402Version: 1,
        error: 'Failed to process payment',
        details: error.message || 'An unexpected error occurred'
      });
      return true;
    }
  };
}

/**
 * Find matching route pattern
 */
function findMatchingRoute(path: string, routes: RoutesConfig): string | null {
  // Exact match first
  if (routes[path]) {
    return path;
  }

  // Wildcard matching
  for (const route in routes) {
    if (route.endsWith('/*')) {
      const prefix = route.slice(0, -2);
      if (path.startsWith(prefix)) {
        return route;
      }
    }
  }

  return null;
}
