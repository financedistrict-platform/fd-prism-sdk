<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net6.0;net7.0;net8.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Prism.AspNetCore</RootNamespace>
    <Version>1.0.1</Version>
    <PackageId>Prism.AspNetCore</PackageId>
    <Description>ASP.NET Core middleware and DI extensions for the Prism Gateway x402 payment protocol.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Prism.Core\Prism.Core.csproj" />
  </ItemGroup>

</Project>
